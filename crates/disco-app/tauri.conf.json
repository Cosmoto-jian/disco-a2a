{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disco",
  "version": "1.6.2",
  "identifier": "dev.cosmoto.disco",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Disco",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MkI2MDIxOUExQUVFRTkKUldUcDdocWFJV0FyVjNLYUMvekNvMEZYQUVXdTFqUzdlOVJ5NVR6RUtuVmUvNDRYUk9MMHRNQkEK",
      "endpoints": [
        "https://raw.githubusercontent.com/Cosmoto-jian/disco-a2a/main/updates/latest.json"
      ]
    }
  }
}
